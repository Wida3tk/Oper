{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sulukera-operations",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sulukera-operations-db",
      "database_id": "d4006093-3057-4758-80f8-2e93b306aa58"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
